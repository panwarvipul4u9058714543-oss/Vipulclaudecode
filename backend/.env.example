# ─── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database (PostgreSQL + PostGIS) ───────────────────────────────────
# For local dev this points at the Docker Compose service.
DATABASE_URL=postgresql://waste:waste@localhost:5432/waste?schema=public

# ─── Redis (live dealer locations + rate limiting + pickup locks) ──────
REDIS_URL=redis://localhost:6379

# ─── Firebase Admin SDK (phone-OTP verification + FCM push) ────────────
# Get this JSON from Firebase console → Project settings → Service accounts.
# Store the full JSON string on ONE line (escape newlines in the private_key field).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── Cloudinary (photo uploads) ────────────────────────────────────────
# Get these from Cloudinary dashboard → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=waste-app

# ─── Matching algorithm knobs ──────────────────────────────────────────
MATCH_INITIAL_RADIUS_KM=3
MATCH_MAX_RADIUS_KM=8
MATCH_EXPAND_AFTER_SECONDS=120
PICKUP_EXPIRY_MINUTES=30
DEALER_LOCATION_TTL_SECONDS=60

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use "*" only in dev.
CORS_ORIGINS=*
